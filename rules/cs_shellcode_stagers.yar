/*
    Cobalt Strike — Shellcode Stager Detection
    Author:      struttonpigeon
    Date:        2026-11-05
    Reference:   https://www.cobaltstrike.com/help-stageless-payload-generator
                 https://blog.didierstevens.com/2021/11/03/cobalt-strike-decoding/

    Cobalt Strike generates shellcode stagers that download and execute a
    beacon payload.  The stagers follow a recognisable prologue that has
    remained stable across major versions (3.x – 4.x).

    These rules target the raw shellcode bytes, not the delivery wrapper
    (HTA / VBS / macro).  Delivery-layer rules are in cs_powershell_loaders.yar.
*/

rule CobaltStrike_Shellcode_Stager_x86
{
    meta:
        description = "Cobalt Strike x86 shellcode stager — classic CLD+CALL prologue"
        author      = "struttonpigeon"
        date        = "2026-11-05"
        reference   = "https://thedfirreport.com/2021/08/29/cobalt-strike-a-defenders-guide/"
        severity    = "critical"
        tlp         = "white"

    strings:
        /*
            FC              CLD                     ; clear direction flag
            E8 ?? 00 00 00  CALL $+??               ; call-over-data trick
                                                    ; the immediate is small (< 0xFF)
                                                    ; because it jumps just past an
                                                    ; inline data block

            This prologue appears in every default x86 stager generated by
            Cobalt Strike.  CLD ensures string operations move forward; the
            CALL pushes the return address (== address of inline data) onto
            the stack so the shellcode can locate itself.
        */
        $prologue_x86 = { FC E8 ?? 00 00 00 }

        /*
            After the prologue the stager resolves kernel32 via the PEB:
            60              PUSHAD
            89 E5           MOV EBP, ESP
            31 C0           XOR EAX, EAX
            64 8B 50 30     MOV EDX, DWORD PTR FS:[EAX+30h]  ; PEB
            8B 52 0C        MOV EDX, [EDX+0Ch]                ; Ldr
            8B 52 14        MOV EDX, [EDX+14h]                ; InMemoryOrderModuleList
        */
        $peb_walk_x86 = { 60 89 E5 31 C0 64 8B 50 30 8B 52 0C 8B 52 14 }

        /*
            API hashing — Cobalt Strike uses a ROR-13 hash to resolve API
            names at runtime.  This constant 0x0D (13) appears in the
            rotate-right loop:
            C1 CF 0D        ROR EDI, 0Dh
        */
        $ror13_hash = { C1 CF 0D }

    condition:
        $prologue_x86 at 0 and $peb_walk_x86 and $ror13_hash
}


rule CobaltStrike_Shellcode_Stager_x64
{
    meta:
        description = "Cobalt Strike x64 shellcode stager — CLD + stack alignment prologue"
        author      = "struttonpigeon"
        date        = "2026-11-05"
        reference   = "https://thedfirreport.com/2021/08/29/cobalt-strike-a-defenders-guide/"
        severity    = "critical"
        tlp         = "white"

    strings:
        /*
            FC                  CLD
            48 83 E4 F0         AND RSP, 0xFFFFFFFFFFFFFFF0  ; 16-byte stack alignment
            E8 ?? ?? ?? ??      CALL <offset>                 ; call-over-data

            The 16-byte stack alignment (AND RSP, -10h) is required by the
            x64 calling convention and is the hallmark of CS x64 stagers.
        */
        $prologue_x64 = { FC 48 83 E4 F0 E8 }

        /*
            x64 PEB walk:
            65 48 8B 52 60      MOV RDX, QWORD PTR GS:[RDX+60h]  ; PEB via GS
            48 8B 52 18         MOV RDX, [RDX+18h]                ; Ldr
            48 8B 52 20         MOV RDX, [RDX+20h]                ; InMemoryOrderModuleList
        */
        $peb_walk_x64 = { 65 48 8B 52 60 48 8B 52 18 48 8B 52 20 }

        /*  ROR-13 in 64-bit form:  41 C1 CF 0D   ROR R15D, 0Dh  */
        $ror13_hash_x64 = { 41 C1 CF 0D }

    condition:
        $prologue_x64 at 0 and $peb_walk_x64 and $ror13_hash_x64
}


rule CobaltStrike_Shellcode_Stager_Generic
{
    meta:
        description = "Generic Cobalt Strike stager — HTTP/HTTPS staging with WinInet"
        author      = "struttonpigeon"
        date        = "2026-11-05"
        reference   = "https://hstechdocs.helpsystems.com/manuals/cobaltstrike/current/userguide/content/topics/malleable-c2_http-staging.htm"
        severity    = "high"
        tlp         = "white"

    strings:
        /* Default User-Agent embedded in stager shellcode */
        $ua_default = "Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Trident/5.0)" ascii

        /* WinInet API string references used by the HTTP stager */
        $wininet    = "wininet" ascii nocase
        $httpopen   = "HttpOpenRequestA" ascii
        $interneto  = "InternetOpenA" ascii

    condition:
        uint8(0) == 0xFC and
        $wininet and
        ($httpopen or $interneto) and
        $ua_default
}
